# KOVANICA: FOUNDRY — Nginx /foundry subpath & /foundry-ws proxy template
# Include inside the existing kovanica.online HTTPS server block on seed1.
#
# Build client:
#   cd /opt/kovanica-game && npm ci && npm run build
# Verify & reload:
#   sudo nginx -t && sudo systemctl reload nginx

location = /foundry {
    return 301 /foundry/;
}

location /foundry/ {
    alias /opt/kovanica-game/dist/;
    index index.html;
    try_files $uri $uri/ /foundry/index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
}

location /foundry/assets/ {
    alias /opt/kovanica-game/dist/assets/;
    expires 30d;
    add_header Cache-Control "public, immutable";
}

location /foundry-ws {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}
